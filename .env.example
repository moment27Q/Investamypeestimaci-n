# Copia este archivo a `.env` y completa tus claves (`.env` está en .gitignore,
# no se sube al repositorio).

# API de Groq (obtén la clave en https://console.groq.com) — la usa el
# módulo "Entorno socioeconómico".
GROK_API_KEY=""

# Modelo de Groq (opcional; por defecto llama-3.3-70b-versatile)
# GROK_MODEL=llama-3.3-70b-versatile

# Alternativa: xAI / Grok (opcional; se usa solo si no hay GROQ_API_KEY)
# XAI_API_KEY=xai-...
# XAI_MODEL=grok-4.5

# ----- Envío de correos (correo de la tasación) -----
# Render Free bloquea SMTP (25/465/587). Lo más fiable es la API de Brevo por
# HTTPS (plan gratis, 300 correos/día). Crea la cuenta en https://www.brevo.com,
# genera una clave API (Menu > SMTP & API > API Keys) y verifica el remitente.
# Con BREVO_API_KEY configurada se usa Brevo; sin ella se intenta SMTP.
# BREVO_API_KEY="xkeysib-..."

# SMTP (solo si NO configuras BREVO_API_KEY o subes Render a plan pago)
# MAIL_HOST="tasador.investamype.com"
# MAIL_PORT="465"
# MAIL_USER="correo@tasador.investamype.com"
# MAIL_PASS="tu-contraseña"
# MAIL_FROM="correo@tasador.investamype.com"
# MAIL_FROM_NAME="Tasador Perú"
