# Copia este archivo a `.env` y completa tus claves (`.env` está en .gitignore,
# no se sube al repositorio).

# API de Groq (obtén la clave en https://console.groq.com) — la usa el
# módulo "Entorno socioeconómico".
GROK_API_KEY=gsk_...

# Modelo de Groq (opcional; por defecto llama-3.3-70b-versatile)
# GROK_MODEL=llama-3.3-70b-versatile

# Alternativa: xAI / Grok (opcional; se usa solo si no hay GROQ_API_KEY)
# XAI_API_KEY=xai-...
# XAI_MODEL=grok-4.5
